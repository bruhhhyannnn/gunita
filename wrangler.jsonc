{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gunita",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gunita",
      "database_id": "975c8517-d879-43e6-b30d-f367673c72b8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "gunita-files" }],
  // Optional: free Workers AI models for inline suggestions (Settings > AI).
  // Uncomment to enable. Local dev then needs `wrangler login`.
  // "ai": { "binding": "AI" },
  "vars": {
    "APP_NAME": "Gunita"
    // "APP_URL": "https://gunita.<your-subdomain>.workers.dev"
  },
  // Used only by the end-to-end tests (CLOUDFLARE_ENV=e2e): a separate local
  // database and bucket, with settings from .dev.vars.e2e (no real keys).
  "env": {
    "e2e": {
      "d1_databases": [{ "binding": "DB", "database_name": "gunita-e2e", "database_id": "e2e-local", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "gunita-e2e-files" }],
      "vars": { "APP_NAME": "Gunita" }
    }
  }
}
