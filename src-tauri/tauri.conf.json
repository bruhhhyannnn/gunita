{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gunita",
  "version": "0.3.0",
  "identifier": "dev.gunita.desktop",
  "build": {
    "frontendDist": "../desktop/fallback"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Gunita",
    "category": "Productivity",
    "shortDescription": "Notes, daily TODOs and a memory that remembers for you.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "gunita"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyODA0NERCMTRDRTQ4NkMKUldSc1NNNFUyMFNBRWc4ZUlIcUJRd0FpVmZTVlQ3U3dlbFNTaEViUFZCckFnZnFBWjZiRE02SzkK",
      "endpoints": [
        "https://github.com/bruhhhyannnn/gunita/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
