{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gunita",
  "version": "0.1.0",
  "identifier": "dev.gunita.desktop",
  "build": {
    "frontendDist": "../desktop/fallback"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Gunita",
    "category": "Productivity",
    "shortDescription": "Notes, daily TODOs and a memory that remembers for you.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["gunita"]
      }
    }
  }
}
