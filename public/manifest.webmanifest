{
  "name": "Gunita",
  "short_name": "Gunita",
  "description": "Notes, daily TODOs and a memory that remembers for you.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#191919",
  "theme_color": "#191919",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Start today", "url": "/?start=today" },
    { "name": "Quick note", "url": "/?capture=1" }
  ]
}
